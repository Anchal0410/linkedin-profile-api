# --- Your LinkedIn account (testing only — never commit the real .env) ---
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=change-me

# Set to false the first time you run `npm run login` so you can see the
# browser and solve any checkpoint/2FA challenge LinkedIn throws at a new
# device/IP. Safe to set true for headless re-logins afterward.
LOGIN_HEADLESS=false

# --- Infra ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/linkedin_profile_api
REDIS_URL=redis://localhost:6380

# --- API ---
PORT=3000
API_KEY=change-me-to-a-long-random-value
# comma-separated requests-per-minute budget enforced per API key
RATE_LIMIT_PER_MINUTE=20

# --- Scraper behavior ---
# minimum delay between two scrape jobs on the same account, in ms
SCRAPE_MIN_DELAY_MS=4000
SCRAPE_MAX_DELAY_MS=9000
CACHE_TTL_HOURS=72
